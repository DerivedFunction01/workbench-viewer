{
  "dependencies": {
    "@hatch/space-sdk": "file:./vendor/space-sdk",
    "@tanstack/react-query": "5.100.10",
    "dompurify": "3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "0.16.47",
    "marked": "18.1.1",
    "mermaid": "^11.17.2",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.2",
    "@types/katex": "^0.16.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "name": "workbench-viewer",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "build": "bun run build:server && bun run build:client",
    "build:client": "bun ./client/build.mjs",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "format": "bun x biome format --write .",
    "lint": "bun x biome check .",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module"
}
