#!/usr/bin/env python3
"""wb — the workbench harness CLI.

A thin caller over lib/: every verb is a lib/ mutation or
read; wb holds no logic of its own and no SQL. The companion
server calls the same lib/ functions — there is exactly one
mutation path in the system. Every mutation verb regenerates
the project's registry.json export (a pure fold; safe to
repeat).

Project selection (first match wins):
  --db PATH         a registry DB directly (fixtures, repair)
  --root PATH       a project root holding workbench.yaml
  --project SLUG    resolved by sweeping the workspace
  (none)            walk up from the cwd for workbench.yaml

Run under the repo venv:  .venv/bin/python wb --help
"""

import argparse
import json
